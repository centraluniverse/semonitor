[Unit]
Description=SolarEdge monitor
Wants=time-sync.target
After=time-sync.target

[Service]
Environment=INVERTERS=730A8690,7F104A16
EnvironmentFile=-/etc/default/semonitor
StateDirectory=semonitor
ExecStart=/bin/sh -c '\
  semonitor -v -t 4 -m -n -s "$${INVERTERS}" /dev/ttyUSB0 | \
  stdbuf -oL uniq | \
  tee "$${STATE_DIRECTORY}/$$(date +%%Y%%m%%d%%H%%M%%S).json" | \
  se2state -i "$${INVERTERS}" -o "$${STATE_DIRECTORY}/solar.json"'
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
